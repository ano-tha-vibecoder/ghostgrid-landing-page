# Copy to .env.local for `npm run dev`; set the same variables in Vercel → Project → Settings → Environment Variables.

# Required: Google AI Studio key (https://aistudio.google.com/apikey). Server-side only, never exposed to the browser.
GEMINI_API_KEY=

# Optional: Gemini model for the chat assistant (default: gemini-3.8-flash)
GEMINI_MODEL=

# Optional: extra origins allowed to call /api/chat, comma-separated (same-site requests are always allowed)
ALLOWED_ORIGINS=
